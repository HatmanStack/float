{
  "name": "float-frontend",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:web": "expo export --platform web && node scripts/inject-seo.js",
    "lint": "eslint . && tsc --noEmit",
    "test": "jest"
  },
  "dependencies": {
    "@expo/metro-runtime": "~57.0.7",
    "@expo/vector-icons": "^15.1.1",
    "@react-native-async-storage/async-storage": "3.1.1",
    "@react-native-google-signin/google-signin": "^16.1.2",
    "@react-navigation/native": "^7.3.14",
    "@react-oauth/google": "^0.13.5",
    "expo": "~57.0.8",
    "expo-av": "^16.0.8",
    "expo-file-system": "^57.0.1",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-notifications": "^57.0.7",
    "expo-permissions": "^14.4.0",
    "expo-router": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.1",
    "expo-web-browser": "^57.0.2",
    "hls.js": "^1.6.16",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-gesture-handler": "~3.1.0",
    "react-native-reanimated": "~4.5.3",
    "react-native-safe-area-context": "5.8.0",
    "react-native-screens": "4.26.2",
    "react-native-web": "~0.21.2",
    "react-native-webview": "^14.0.1",
    "react-native-worklets": "^0.10.3"
  },
  "devDependencies": {
    "@babel/core": "^8.0.1",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^30.0.0",
    "@types/react": "~19.2",
    "@typescript-eslint/eslint-plugin": "^8.46.2",
    "@typescript-eslint/parser": "^8.46.2",
    "babel-plugin-module-resolver": "^5.0.2",
    "eslint": "^10.8.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "jest": "^30.3.0",
    "jest-expo": "~57.0.3",
    "react-test-renderer": "19.2.8",
    "typescript": "~7.0.2"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "preset": "jest-expo",
        "roots": [
          "<rootDir>/tests/unit"
        ],
        "testMatch": [
          "**/*-test.tsx",
          "**/*-test.ts"
        ],
        "setupFiles": [
          "./jest.globals.js",
          "./jest.setup.js"
        ],
        "setupFilesAfterEnv": [
          "./tests/unit/utils/setup.ts"
        ],
        "testPathIgnorePatterns": [
          "/node_modules/",
          "/tests/unit/utils/"
        ],
        "moduleNameMapper": {
          "^@/(.*)$": "<rootDir>/$1",
          "^expo-file-system/legacy": "expo-file-system"
        }
      },
      {
        "displayName": "integration",
        "preset": "jest-expo",
        "roots": [
          "<rootDir>/tests/integration"
        ],
        "testMatch": [
          "**/*-test.tsx",
          "**/*-test.ts"
        ],
        "setupFiles": [
          "./jest.globals.js",
          "./jest.setup.js"
        ],
        "setupFilesAfterEnv": [
          "./tests/integration/setup.ts"
        ],
        "testPathIgnorePatterns": [
          "/node_modules/",
          "/tests/integration/setup.ts",
          "/tests/integration/test-utils.tsx"
        ],
        "moduleNameMapper": {
          "^@/(.*)$": "<rootDir>/$1",
          "^expo-file-system/legacy": "expo-file-system"
        }
      }
    ]
  },
  "private": true
}
